# ==============================================================================
# TRAXO AGENTE — VARIABLES DE ENTORNO OFICIALES (v2.0-hardened)
# ==============================================================================
# Copia este archivo a .env o configúralo en las variables de entorno de Dokploy.
# La validación se ejecuta en apps/worker/src/env.ts con Zod estricto al arrancar.

# --- Servidor y Sesiones ---
NODE_ENV=production
PORT=4000
TRAXO_SESSION_SECRET=super_secret_session_token_min_32_characters_long_12345
TRAXO_DATA_DIR=.traxo-data/pg
TRAXO_MEDIA_DIR=.traxo-data/media

# --- Base de Datos PostgreSQL ---
# En Dokploy / Docker: postgresql://traxo:secret@postgres:5432/traxo
# Si se deja vacío, Traxo arranca en modo local PGlite (WASM en disco)
DATABASE_URL=

# --- Moneda y Mercado Venezuela ---
TRAXO_BCV_RATE=880.00
TRAXO_STORE_NAME=Davebeauty
TRAXO_STORE_URL=https://davebeauty.daverod.tech

# --- WooCommerce HPOS (Backend de eCommerce) ---
WOOCOMMERCE_URL=https://apiv2backecom.daverod.tech
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=

# --- Proveedores LLM (Inferencia Multi-Provider en Cascada) ---
# Si se omiten todas las claves, el sistema opera con el motor determinista local firmado
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

XAI_API_KEY=
XAI_MODEL=grok-2-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Frenos de Gasto y Rate Limiting
TRAXO_AI=on
TRAXO_AI_PER_MIN=10
TRAXO_AI_PER_STORE_DAILY=100
TRAXO_RATE_PER_MIN=300

# --- Analítica en Vivo ("Pulso en Vivo") ---
# Google Analytics 4 (Data API sin SDKs pesados, firma RS256 nativa)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_B64=

# Microsoft Clarity
CLARITY_PROJECT_ID=
CLARITY_API_TOKEN=

# --- Integraciones Server-to-Server (n8n Webhook Outbound & Revalidación) ---
N8N_OUTBOUND_WEBHOOK_URL=https://n8n.daverod.tech/webhook/traxo-creative-pipeline
N8N_HMAC_SECRET=n8n_hmac_secret_key_16_chars_min

# --- Acceso de Administración ---
TRAXO_ADMIN_EMAIL=
TRAXO_ADMIN_PASSWORD=
TRAXO_API_TOKEN=
TRAXO_AUDIT_LIVE=1
